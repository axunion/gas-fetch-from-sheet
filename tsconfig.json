{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["google-apps-script"],
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
